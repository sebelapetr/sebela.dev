# Example production configuration for compose.yaml with infra/production/compose.yaml
# (infra/README.md). Placeholders and documented example values only: never put a credential or
# real data here. The real file lives only on the server (mode 600, owner `deploy`) and is passed
# with `--env-file`; it never enters Git, an image or a log. Every `replace-with-...` value must be
# replaced. Development settings and their full descriptions: the root .env.example.

# Image tags, one per service: the commit SHA each image was built from. They are placeholders: a
# deployment exports the tags of its release and these values are never used, so a manual command
# must export the running release's tags too (infra/README.md). The migration runs the API's image.
API_IMAGE_TAG=replace-with-the-api-image-commit-sha
WEB_IMAGE_TAG=replace-with-the-web-image-commit-sha
MCP_ADMIN_IMAGE_TAG=replace-with-the-mcp-admin-image-commit-sha
# The AI service's image, read only with the profile `ai-service` (the next setting).
AI_SERVICE_IMAGE_TAG=replace-with-the-ai-service-image-commit-sha
# The chat's switch: empty keeps the AI service off. `ai-service` starts it with the next deployment
# (infra/README.md, "The AI service and the visitor chat"), together with the chat settings below.
COMPOSE_PROFILES=

# Postgres. Compose needs POSTGRES_HOST and POSTGRES_PORT to read the root compose.yaml, but the
# production composition publishes no Postgres port: only the migration and the API reach it, by its
# service name inside the Compose network.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# The cluster's superuser and its database, taken when the volume is first initialised. The
# superuser also creates the pgvector extension and the application role once (infra/README.md).
POSTGRES_USER=replace-with-the-superuser-name
POSTGRES_PASSWORD=replace-with-the-superuser-password
POSTGRES_DB=sebela
# The database the migration and the API use, and the application role they connect as: not the
# superuser.
DATABASE_NAME=sebela
DATABASE_USER=replace-with-the-application-role
DATABASE_PASSWORD=replace-with-the-application-role-password

# The API (apps/api/AGENTS.md, "Configuration"). It has no host port: the website and MCP Admin
# call it inside the Compose networks. Largest request body in bytes.
API_BODY_LIMIT_BYTES=196608
# No reverse proxy sits in front of the API, so no forwarded address is believed. The visitor chat
# does not need one: the website's relay names the visitor's address with API_CHAT_RELAY_TOKEN.
API_TRUSTED_PROXIES=
# Rate-limit budgets, `<requests>/<seconds>`, and the most callers tracked at once.
API_RATE_LIMIT_HEALTH=120/60
API_RATE_LIMIT_PUBLIC=300/60
API_RATE_LIMIT_PRIVATE=60/60
API_RATE_LIMIT_KEY=120/60
API_RATE_LIMIT_MAX_TRACKED=10000
API_RATE_LIMIT_UPLOAD=10/60
# Signs the API's invalidation notifications to the website container: a random value of at least
# 32 characters, the same as WEB_INVALIDATION_SECRET.
API_WEB_INVALIDATION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# The visitor chat (apps/api/AGENTS.md, "Configuration"). Off in production: every setting empty, so
# its routes answer 503 and the API is given no AI service address. It is switched on together with
# the AI service (COMPOSE_PROFILES=ai-service above), by the procedure of infra/README.md. Then:
# API_CHAT_ALLOWED_ORIGINS=https://sebela.dev, API_CHAT_COOKIE_SECURE=true,
# API_TURNSTILE_EXPECTED_HOSTNAME=sebela.dev, the real Turnstile secret (never a test key; production
# refuses one), an empty API_TURNSTILE_VERIFY_URL, API_CHAT_MODEL, API_CHAT_EFFORT and
# API_CHAT_PRICING_VERSION equal to the agent's versions, random tokens and fingerprint key of at
# least 32 characters each, and the chat relay token API_CHAT_RELAY_TOKEN, a random value of at
# least 32 characters of its own, also set as WEB_CHAT_RELAY_TOKEN (with WEB_TRUSTED_PROXY_HOPS=1,
# below). The composition calls the AI service by its service name and gives it the same two tokens.
API_CHAT_ALLOWED_ORIGINS=
API_CHAT_COOKIE_SECURE=
API_CHAT_FINGERPRINT_KEY=
API_CHAT_RETENTION_DAYS=
API_CHAT_MODEL=
API_CHAT_EFFORT=
API_CHAT_PRICING_VERSION=
API_CHAT_RELAY_TOKEN=
API_TURNSTILE_SECRET_KEY=
API_TURNSTILE_EXPECTED_HOSTNAME=
API_TURNSTILE_VERIFY_URL=
API_AI_SERVICE_URL=
API_AI_SERVICE_TOKEN=
API_AI_CONTROL_TOKEN=
# Remote deletion of exported chat traces (`chat-maintenance delete-telemetry`, apps/api/AGENTS.md,
# Commands): the Langfuse project's base address (EU: https://cloud.langfuse.com) and keys, the
# same project as the AI service's below. All three or none; empty leaves the deletions pending.
# The secret key is a secret.
API_LANGFUSE_BASE_URL=
API_LANGFUSE_PUBLIC_KEY=
API_LANGFUSE_SECRET_KEY=

# The AI service (apps/ai-service/AGENTS.md, "Configuration"), with the profile `ai-service` only. It
# has no host port and no database, storage or API key setting. Empty means the fictional model,
# which it refuses here (STORAGE_ENVIRONMENT=production): the chat needs AI_SERVICE_MODEL=anthropic,
# AI_SERVICE_ALLOW_PAID=true, a daily ceiling of at most 0.25 USD and the provider key.
AI_SERVICE_MODEL=
AI_SERVICE_FAKE_SCENARIO=
AI_SERVICE_ALLOW_PAID=
AI_SERVICE_DAILY_CEILING_USD=
# Concurrent operations (1 to 4), the admission wait (at most 2 s) and the shutdown grace (at most
# 65 s); empty for the defaults of 4, 2 and 25.
AI_SERVICE_MAX_OPERATIONS=
AI_SERVICE_ADMISSION_WAIT_S=
AI_SERVICE_SHUTDOWN_GRACE_S=
# The metadata-only trace export to Langfuse (apps/ai-service/AGENTS.md, Trace export): the same
# project's base address and keys; any one empty turns the export off. The secret key is a secret.
# The environment label: `production` here.
AI_SERVICE_LANGFUSE_BASE_URL=
AI_SERVICE_LANGFUSE_PUBLIC_KEY=
AI_SERVICE_LANGFUSE_SECRET_KEY=
AI_SERVICE_LANGFUSE_ENVIRONMENT=
# The model provider's key stays empty while the paid model is off; it is a secret that lives only in
# the real file on the server, never in a development file.
ANTHROPIC_API_KEY=

# Uploaded media in Bunny Storage (docs/architecture.md, "Bunny Storage"): the production zone's S3
# endpoint, region, zone name and password, and its CDN pull zone's https address as the public
# base. Keys start with the environment `production`; there is no worktree folder.
STORAGE_DRIVER=bunny-s3
STORAGE_ENVIRONMENT=production
STORAGE_WORKTREE=
STORAGE_PUBLIC_BASE_URL=replace-with-the-pull-zone-https-address
STORAGE_BUNNY_ENDPOINT=replace-with-the-zone-s3-endpoint
STORAGE_BUNNY_REGION=replace-with-the-zone-region
STORAGE_BUNNY_ZONE=replace-with-the-zone-name
STORAGE_BUNNY_PASSWORD=replace-with-the-zone-password
# Largest accepted file in bytes, and largest image width and height in pixels.
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_IMAGE_DIMENSION=8000

# The website (apps/web/AGENTS.md, "Configuration"). Published on the host's loopback interface
# only, on a port free on the server, where the server's nginx proxies sebela.dev to it
# (infra/nginx/sebela.dev.conf).
WEB_HOST=127.0.0.1
WEB_PORT=3000
# The canonical public origin.
WEB_SITE_ORIGIN=https://sebela.dev
# The media folder pages show images from: STORAGE_PUBLIC_BASE_URL followed by `/production`; with
# Bunny Storage the server reads the files from the same address.
WEB_MEDIA_BASE_URL=replace-with-the-pull-zone-https-address/production
WEB_MEDIA_READ_BASE_URL=replace-with-the-pull-zone-https-address/production
# Verifies the API's invalidation notifications: the same value as API_WEB_INVALIDATION_SECRET.
WEB_INVALIDATION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# The fallback revalidation interval in seconds; empty for the default of 60.
WEB_CONTENT_REVALIDATE_SECONDS=
# Umami page-view analytics (apps/web/AGENTS.md, Configuration): the tracker script's HTTPS address
# and the website's ID on Umami Cloud, both public (they appear in every page). Both empty: no
# analytics. The production values are set during the server preparation (infra/README.md).
WEB_ANALYTICS_SCRIPT_URL=
WEB_ANALYTICS_WEBSITE_ID=
# `on` lets search engines index the site; empty sends `noindex, nofollow` everywhere. Switch it on
# only for the launch with real data.
WEB_INDEXING=
# The public Turnstile site key of the chat's bot challenge; empty while the chat is off.
WEB_TURNSTILE_SITE_KEY=
# The chat relay's token, the same value as API_CHAT_RELAY_TOKEN; empty while the chat is off.
WEB_CHAT_RELAY_TOKEN=
# One proxy appends to X-Forwarded-For in front of the website: the host's nginx, which resolves the
# visitor's address from the CDN's X-Real-IP. The relay names that rightmost entry to the API.
WEB_TRUSTED_PROXY_HOPS=1

# MCP Admin (apps/mcp-admin/AGENTS.md, "Configuration"). Published only on the host's loopback
# interface (MCP_ADMIN_HOST, MCP_ADMIN_PORT), as the target of the owner's SSH tunnel; nginx never
# proxies to it. It holds no API key: each caller sends its own.
# Host names a request's Host header may name, and browser origins allowed (none).
MCP_ADMIN_HOST=127.0.0.1
MCP_ADMIN_PORT=3102
MCP_ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost
MCP_ADMIN_ALLOWED_ORIGINS=
MCP_ADMIN_TRUSTED_PROXIES=
# Largest request body in bytes, longest request in milliseconds, most requests at once.
MCP_ADMIN_BODY_LIMIT_BYTES=65536
MCP_ADMIN_TIMEOUT_MS=15000
MCP_ADMIN_MAX_CONCURRENT=8
# Rate-limit budgets, `<requests>/<seconds>`, and the most callers tracked at once.
MCP_ADMIN_RATE_LIMIT_PREAUTH=30/60
MCP_ADMIN_RATE_LIMIT_KEY=30/60
MCP_ADMIN_RATE_LIMIT_MAX_TRACKED=1000

# Retrieval over the private knowledge index (docs/architecture.md, "Knowledge and retrieval";
# apps/api/AGENTS.md, "Configuration"). Off in production: every setting empty, so the API serves
# no search and calls no provider. The public search path, its budget and these values arrive with
# phase 9.1; until then the private search runs only in development checkouts.
RETRIEVAL_EMBEDDING_MODEL=
RETRIEVAL_EMBEDDING_PRICE_PER_MILLION_TOKENS_USD=
RETRIEVAL_EMBEDDING_BATCH_SIZE=
RETRIEVAL_RERANK_MODEL=
RETRIEVAL_RERANK_PRICE_PER_MILLION_TOKENS_USD=
RETRIEVAL_PROVIDER_TIMEOUT_MS=
RETRIEVAL_PROVIDER_RETRIES=
RETRIEVAL_PROVIDER_MAX_RETRY_WAIT_MS=
RETRIEVAL_MONTHLY_CEILING_USD=
RETRIEVAL_CANDIDATE_POOL=
RETRIEVAL_FINAL_PASSAGES=
RETRIEVAL_RELEVANCE_FLOOR=
# The provider key stays empty while retrieval is off; it is a secret and is never written into a
# file Compose reads in a development checkout (compose.yaml).
VOYAGE_API_KEY=

# Backups (infra/scripts/backup.sh, infra/README.md, "Backups"), read by the scripts only, never by
# a container. The Bunny Storage zone of the backups, separate from the media zone: its HTTP
# storage endpoint (the https address of the zone's region, no path), its name and its password.
BACKUP_STORAGE_ENDPOINT=replace-with-the-backup-zone-storage-https-endpoint
BACKUP_STORAGE_ZONE=sebela-backups
BACKUP_STORAGE_PASSWORD=replace-with-the-backup-zone-password
# The owner's age public key (`age1...`) the dumps are encrypted to; its private key stays offline
# with the owner and is never put on the server.
BACKUP_AGE_RECIPIENT=replace-with-the-owner-age-public-key
# The Better Stack heartbeat address pinged after each successful backup (a secret address).
BACKUP_HEARTBEAT_URL=replace-with-the-better-stack-heartbeat-url
