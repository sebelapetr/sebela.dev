{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc", "pnpm-workspace.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "POSTGRES_HOST",
        "POSTGRES_PORT",
        "DATABASE_NAME",
        "DATABASE_USER",
        "DATABASE_PASSWORD"
      ]
    },
    "@sebela/mcp-admin#test": {
      "dependsOn": ["^build", "@sebela/api#build"],
      "passThroughEnv": [
        "POSTGRES_HOST",
        "POSTGRES_PORT",
        "DATABASE_NAME",
        "DATABASE_USER",
        "DATABASE_PASSWORD"
      ]
    },
    "//#lint:root": {},
    "//#check:config": {
      "cache": false
    },
    "//#test:harness": {},
    "//#test:checks": {},
    "test:e2e": {
      "dependsOn": ["build", "@sebela/api#build"],
      "cache": false,
      "passThroughEnv": [
        "POSTGRES_HOST",
        "POSTGRES_PORT",
        "DATABASE_NAME",
        "DATABASE_USER",
        "DATABASE_PASSWORD",
        "CI"
      ]
    }
  }
}
