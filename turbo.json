{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc", "pnpm-workspace.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "//#lint:root": {},
    "//#check:config": {
      "cache": false
    },
    "//#test:harness": {},
    "//#test:checks": {}
  }
}
