{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node harness/*)",
      "Bash(node --test harness/)",
      "Bash(harness/run-phase.sh *)",
      "Bash(pnpm *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree list)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)"
    ],
    "ask": [
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh label *)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git worktree remove *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.production)",
      "Read(./.env.secrets)",
      "Read(**/.env.secrets)",
      "Edit(./.env.secrets)",
      "Edit(**/.env.secrets)",
      "Write(./.env.secrets)",
      "Write(**/.env.secrets)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin master)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:master)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/hooks/pre-tool-use.mjs\""
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/hooks/developer-handoff.mjs\"",
            "timeout": 960
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/hooks/post-tool-use.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/hooks/format-edited-file.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "backend-developer|frontend-developer|ai-developer",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/hooks/developer-handoff.mjs\"",
            "timeout": 960
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/hooks/worktree-create.mjs\""
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/hooks/worktree-remove.mjs\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/harness/hooks/pre-compact.mjs\""
          }
        ]
      }
    ]
  }
}
