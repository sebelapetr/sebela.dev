  "components": {
    "schemas": {
      "Accepted": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "const": true,
            "title": "Accepted",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Accepted"
      },
      "CapabilityPage": {
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "get_profile",
              "list_experiences",
              "list_projects",
              "get_project",
              "list_services",
              "list_explorations",
              "list_education",
              "list_current_focus",
              "get_roadmap",
              "get_roadmap_area",
              "get_learning_diary",
              "get_learning_statistics",
              "list_books",
              "list_events",
              "list_technologies"
            ],
            "title": "Capability"
          },
          "page": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Page"
          },
          "pageCount": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Pagecount"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/CapabilityRecord"
            },
            "type": "array",
            "title": "Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "capability",
          "page",
          "pageCount",
          "records"
        ],
        "title": "CapabilityPage",
        "description": "One page of a read capability; `page_count` pages hold every record, in order."
      },
      "CapabilityRecord": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "profile",
              "contact",
              "experience",
              "project",
              "exploration",
              "service",
              "education",
              "current_focus",
              "roadmap",
              "roadmap_area",
              "roadmap_module",
              "diary_day",
              "statistics",
              "book",
              "event",
              "technology"
            ],
            "title": "Kind"
          },
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 500,
            "title": "Title"
          },
          "href": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^/(?:[^/\\s\\\\\\x00-\\x1f\\x7f][^\\s\\\\\\x00-\\x1f\\x7f]*)?$",
            "title": "Href"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "id",
          "title",
          "href",
          "data"
        ],
        "title": "CapabilityRecord",
        "description": "One projected record, exactly as the in-process tool gives it to the model."
      },
      "GenerationRequest": {
        "additionalProperties": false,
        "description": "One admitted question the API dispatches with its one-use grant and its deadline.",
        "properties": {
          "operationId": {
            "format": "uuid",
            "title": "Operationid",
            "type": "string"
          },
          "grant": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Grant",
            "type": "string"
          },
          "question": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryExchange"
            },
            "maxItems": 6,
            "title": "History",
            "type": "array"
          },
          "today": {
            "format": "date",
            "title": "Today",
            "type": "string"
          },
          "deadlineAt": {
            "format": "date-time",
            "title": "Deadlineat",
            "type": "string"
          },
          "contextRevision": {
            "minimum": 0,
            "title": "Contextrevision",
            "type": "integer"
          },
          "model": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "effort": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Effort",
            "type": "string"
          },
          "pricingVersion": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Pricingversion",
            "type": "string"
          },
          "allowanceUsd": {
            "exclusiveMinimum": 0,
            "maximum": 0.02,
            "title": "Allowanceusd",
            "type": "number"
          }
        },
        "required": [
          "operationId",
          "grant",
          "question",
          "today",
          "deadlineAt",
          "contextRevision",
          "model",
          "effort",
          "pricingVersion",
          "allowanceUsd"
        ],
        "title": "GenerationRequest",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "HistoryExchange": {
        "additionalProperties": false,
        "description": "One earlier answered exchange, as the API projects it; untrusted conversation data.",
        "properties": {
          "question": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "answer": {
            "maxLength": 32000,
            "minLength": 1,
            "title": "Answer",
            "type": "string"
          },
          "language": {
            "enum": [
              "en",
              "cs"
            ],
            "title": "Language",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/HistorySource"
            },
            "maxItems": 8,
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "question",
          "answer",
          "language"
        ],
        "title": "HistoryExchange",
        "type": "object"
      },
      "HistorySource": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "person",
              "experience",
              "project",
              "exploration",
              "service",
              "technology_group",
              "roadmap_item"
            ],
            "title": "Kind",
            "type": "string"
          },
          "recordId": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Recordid",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "recordId",
          "title"
        ],
        "title": "HistorySource",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "busy",
              "unauthorized",
              "version_mismatch",
              "unavailable",
              "not_found",
              "invalid_arguments",
              "rate_limited"
            ],
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code"
        ],
        "title": "Problem",
        "description": "A refusal with a stable code and nothing else."
      },
      "Ready": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "stopping"
            ],
            "title": "Status",
            "default": "ready"
          }
        },
        "type": "object",
        "title": "Ready"
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
