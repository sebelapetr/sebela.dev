{
  "extends": "@sebela/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "src",
    "e2e",
    "scripts",
    "*.ts",
    "*.mjs",
    "*.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
