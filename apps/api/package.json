{
  "name": "@sebela/api",
  "version": "0.0.0",
  "private": true,
  "description": "The Hono HTTP API, the only gateway to the data.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "api-keys": "pnpm --silent --filter \"@sebela/api...\" build && node --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/cli/api-keys.js",
    "build": "tsc --project tsconfig.build.json",
    "dev": "pnpm --silent --filter \"@sebela/api^...\" build && node --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --watch --import tsx src/server.ts",
    "lint": "eslint .",
    "openapi:export": "pnpm --silent --filter \"@sebela/api...\" build && node dist/cli/openapi.js",
    "seed": "pnpm --silent --filter \"@sebela/api...\" build && node --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/cli/seed.js",
    "serve:e2e": "pnpm --silent --filter \"@sebela/api^...\" build && node --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local --import tsx src/cli/e2e-server.ts",
    "start": "pnpm --silent --filter \"@sebela/api...\" build && node --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/server.js",
    "storage": "pnpm --silent --filter \"@sebela/api...\" build && node --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/cli/storage.js",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@scalar/hono-api-reference": "0.12.20",
    "@sebela/contracts": "workspace:*",
    "@sebela/services": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@sebela/api-client": "workspace:*",
    "@sebela/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
