# Example development configuration. Placeholders and documented example values only: never put
# credentials or real data here. Code reads these settings from the environment and does not carry
# its own copies (docs/repository-structure.md, "Ports and worktree isolation").
#
# Installation (`pnpm install --frozen-lockfile`) needs no settings. The main checkout uses these
# values; copy this file to `.env` there (Compose reads it) and choose your own password. Each
# worktree gets its own `.env.local`, generated by `node harness/worktree.mjs create`, with
# its slot, its shifted ports, its database and its database role's credentials.

# Worktree slot: 0 is the main checkout, worktrees take 1 to 9.
WORKTREE_SLOT=0

# Ports of the main checkout (slot 0). A worktree with slot N uses each of them + N x 10.
# The worktree script reads them from the process environment first, then from this file.
WEB_PORT=3000
API_PORT=3001
MCP_ADMIN_PORT=3002
LLM_AGENT_PORT=3003

# The API process (apps/api/AGENTS.md, "Configuration"). Every setting is required.
# Interface the API listens on. A deployment that publishes the API from a container sets its own.
API_HOST=127.0.0.1
# Largest accepted request body in bytes, enforced while the body is received.
API_BODY_LIMIT_BYTES=65536
# Comma-separated addresses of reverse proxies whose X-Forwarded-For is believed. Empty: the client
# address is the connection's and forwarded headers are ignored.
API_TRUSTED_PROXIES=
# Rate-limit budgets, `<requests>/<seconds>` per caller in a fixed window. Health checks have their
# own budget; public covers public reads, the OpenAPI document, the reference and unknown routes;
# private counts every private request per client before its key is verified; key counts the
# requests of each verified API key.
API_RATE_LIMIT_HEALTH=120/60
API_RATE_LIMIT_PUBLIC=300/60
API_RATE_LIMIT_PRIVATE=60/60
API_RATE_LIMIT_KEY=120/60
# Most callers tracked at once across all budgets; beyond it the oldest window is forgotten.
API_RATE_LIMIT_MAX_TRACKED=10000

# The shared Postgres of compose.yaml: one container for the main checkout and every worktree.
# Compose reads these from the process environment or from `.env` next to compose.yaml.
# Address and host port the container is published on, and that code connects to. The same for
# every worktree; only the database differs.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
# Superuser of the local development cluster. The password is a placeholder: set your own in `.env`
# before the first start. User and password take effect when the volume is first initialised.
POSTGRES_USER=sebela
POSTGRES_PASSWORD=replace-with-a-local-password
# Database created when the volume is first initialised: the main checkout's database. The
# worktree script connects to it to create and drop the worktree databases.
POSTGRES_DB=sebela

# The database this checkout's code uses. The main checkout uses POSTGRES_DB; the worktree script
# creates a database for each worktree (`wt_<branch>_<hash>`) and writes its name here.
DATABASE_NAME=sebela
# The role this checkout's code connects as, and its password. No script creates a role for the
# main checkout: it connects as POSTGRES_USER with POSTGRES_PASSWORD, set as its own in
# `.env`. The worktree script creates a role for each worktree, named like its database, that owns
# its database and may create temporary ones, and writes its name and a random password here. The
# superuser password above never reaches a worktree.
DATABASE_USER=sebela
DATABASE_PASSWORD=replace-with-a-local-password
