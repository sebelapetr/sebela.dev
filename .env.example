# Example development configuration. Placeholders and documented example values only: never put
# credentials or real data here. Code reads these settings from the environment and does not carry
# its own copies (docs/repository-structure.md, "Ports and worktree isolation").
#
# Installation (`pnpm install --frozen-lockfile`) needs no settings. The main checkout uses these
# values; copy this file to `.env` there (Compose reads it) and choose your own password. Each
# worktree gets its own `.env.local`, generated by `node harness/worktree.mjs create`, with
# its slot, its shifted ports, its database and its database role's credentials.
#
# Two example files: this one holds the settings — ports, addresses, limits and the local
# passwords of the development database — which agents may read and, in their worktree's
# `.env.local`, change. `.env.secrets.example` holds the owner's keys for paid outside services,
# which agents never see: they live only in the main checkout's `.env.secrets` and reach only the
# command that needs them (docs/permissions.md, "Environment files").

# Worktree slot: 0 is the main checkout, worktrees take 1 to 9.
WORKTREE_SLOT=0

# Ports of the main checkout (slot 0). A worktree with slot N uses each of them + N x 10.
# The worktree script reads them from the process environment first, then from this file.
# LLM_AGENT_PORT is the AI service's (apps/ai-service), the port the API dispatches questions to.
WEB_PORT=3000
API_PORT=3001
MCP_ADMIN_PORT=3002
LLM_AGENT_PORT=3003

# The API process (apps/api/AGENTS.md, "Configuration"). Every setting is required.
# Interface the API listens on. The container stack (`pnpm stack:up`) publishes the API on this
# address of the host and listens on every interface inside its container.
API_HOST=127.0.0.1
# Largest accepted request body in bytes, enforced while the body is received. 192 KiB leaves room
# for the longest case study (50,000 characters) written in three-byte UTF-8 characters.
API_BODY_LIMIT_BYTES=196608
# Comma-separated addresses of reverse proxies whose X-Forwarded-For is believed. Empty: the client
# address is the connection's and forwarded headers are ignored.
API_TRUSTED_PROXIES=
# Rate-limit budgets, `<requests>/<seconds>` per caller in a fixed window. Health checks have their
# own budget; public covers public reads, the OpenAPI document, the reference and unknown routes;
# private counts every private request per client before its key is verified; key counts the
# requests of each verified API key.
API_RATE_LIMIT_HEALTH=120/60
API_RATE_LIMIT_PUBLIC=300/60
API_RATE_LIMIT_PRIVATE=60/60
API_RATE_LIMIT_KEY=120/60
# Most callers tracked at once across all budgets; beyond it the oldest window is forgotten.
API_RATE_LIMIT_MAX_TRACKED=10000
# Uploads count against their own per-client budget instead of the private one; keep it stricter.
API_RATE_LIMIT_UPLOAD=10/60
# Signed website invalidation after committed content writes (apps/api/AGENTS.md, "Website
# invalidation"): the website's receiver, an http or https address without credentials, query or
# fragment, and the server-only signing secret of at least 32 characters, shared with the website
# only. Both empty: no notifications are sent. Never put a real secret in this file.
API_WEB_INVALIDATION_URL=
API_WEB_INVALIDATION_SECRET=
# The visitor chat (apps/api/AGENTS.md, "Configuration"; docs/architecture.md, "Chat"). All empty:
# the chat is off and its routes answer 503 `unavailable`. Setting any one of them requires every
# one except API_CHAT_RETENTION_DAYS and API_TURNSTILE_VERIFY_URL, which have defaults; the API
# refuses to start with half of them. Never put a real secret or key in this file. Worktree setup
# writes every one of them into the worktree's .env.local: generated tokens and fingerprint key of
# its own, the worktree's own website origin and AI service address, Cloudflare's test keys and the
# agent's model and pricing version (docs/repository-structure.md, "Ports and worktree isolation").
# Comma-separated exact website origins (scheme, host, port) a visitor's question may come from;
# any other Origin, or a body that is not JSON, is refused with 403 before anything is stored.
API_CHAT_ALLOWED_ORIGINS=
# `true` sends the chat cookie with `Secure` (production, https); `false` for plain http locally.
API_CHAT_COOKIE_SECURE=
# The keyed hash of visitor identifiers and addresses for the quotas: a random value of at least 32
# characters. Changing it starts every quota afresh.
API_CHAT_FINGERPRINT_KEY=
# Whole days a conversation is kept after its visitor was last seen; empty for the default of 730.
# `pnpm --filter @sebela/api chat-maintenance delete-expired` deletes the expired ones.
API_CHAT_RETENTION_DAYS=
# The main model, its reasoning effort and the pricing version the AI service generates with,
# bound to each admitted question and recorded with its answer and spend: printable labels without
# spaces, up to 100 characters. The AI service refuses any other.
API_CHAT_MODEL=
API_CHAT_EFFORT=
API_CHAT_PRICING_VERSION=
# The website's chat relay token, a random value of at least 32 characters, the same as the
# website's WEB_CHAT_RELAY_TOKEN and unlike the AI service tokens. The visitor chat routes refuse,
# with 403, every request without it, and believe the visitor address the relay names in
# `x-sebela-chat-client` only with it; API_TRUSTED_PROXIES plays no part in the chat.
API_CHAT_RELAY_TOKEN=
# Cloudflare Turnstile bot challenge. Development and tests use Cloudflare's published test keys
# (always-pass secret `1x0000000000000000000000000000000AA`); production refuses them and needs the
# real secret, which never enters a development checkout, CI or a log. The host name a token must
# have been issued on: the local website host in development, sebela.dev in production.
API_TURNSTILE_SECRET_KEY=
API_TURNSTILE_EXPECTED_HOSTNAME=
# Where tokens are verified; empty for Cloudflare's Siteverify, the only address production accepts.
# Tests point it at a local fake.
API_TURNSTILE_VERIFY_URL=
# The AI service's generation endpoint base (an http or https address without credentials, query or
# fragment) and the token the API sends it, at least 32 characters.
API_AI_SERVICE_URL=
API_AI_SERVICE_TOKEN=
# The token the AI service sends on the internal chat control routes, at least 32 characters and
# different from API_AI_SERVICE_TOKEN; the API compares it in constant time and accepts it nowhere
# else.
API_AI_CONTROL_TOKEN=
# Remote deletion of exported chat traces by `chat-maintenance delete-telemetry`
# (apps/api/AGENTS.md, Commands): the Langfuse project's base address (the EU one is
# https://cloud.langfuse.com) and its public and secret keys, the same project as the AI service's
# below. All three or none; empty leaves the deletions pending. The secret key belongs only in the
# server's production environment file, never in a development checkout; leave these empty here.
API_LANGFUSE_BASE_URL=
API_LANGFUSE_PUBLIC_KEY=
API_LANGFUSE_SECRET_KEY=

# The AI service (apps/ai-service/AGENTS.md, "Configuration"). It listens on LLM_AGENT_PORT and reads
# its settings from the process environment only; empty optional settings take their defaults.
# Interface it listens on. Keep it on loopback: only the API calls it. Worktree setup reads it to
# write API_AI_SERVICE_URL. The container stack ignores it and listens inside its own network.
AI_SERVICE_HOST=127.0.0.1
# The API base it reads public content from and reports results to (http or https). Required;
# worktree setup writes the worktree's own API address.
AI_SERVICE_API_URL=
# The bearer the API presents on its generation route: the same value as API_AI_SERVICE_TOKEN, at
# least 32 characters. Required; worktree setup generates the pair.
AI_SERVICE_TOKEN=
# The bearer it presents on the API's chat control routes: the same value as API_AI_CONTROL_TOKEN,
# at least 32 characters and different from AI_SERVICE_TOKEN. Required; worktree setup generates
# the pair.
AI_SERVICE_CONTROL_TOKEN=
# `fake` (the default) drives the real agent with a fictional model, no provider and no cost.
# `anthropic` is paid: it needs AI_SERVICE_ALLOW_PAID=true, AI_SERVICE_DAILY_CEILING_USD and the
# provider key from the secret wrapper, and is never used in tests or CI.
AI_SERVICE_MODEL=
# The fictional model's behaviour: `answer` (the default), `slow`, `refuse` or `fail`. Server
# configuration only, never a request field.
AI_SERVICE_FAKE_SCENARIO=
# For the fictional model in tests only, both refused with the paid model; leave them empty. An
# absolute file below `.tmp/` that receives one JSON line per model call (its stage and how many
# earlier exchanges it was given), so a test can count the calls.
AI_SERVICE_FAKE_CALLS_FILE=
# An absolute file below `.tmp/`: in the `slow` scenario the security call waits until it exists
# (or the deadline), so a test decides when a generation goes on.
AI_SERVICE_FAKE_GATE_FILE=
# `true` allows the paid `anthropic` model; empty for the default of `false`.
AI_SERVICE_ALLOW_PAID=
# The paid model's own daily ceiling in USD per UTC day, above 0 and at most 0.25. Empty: none.
AI_SERVICE_DAILY_CEILING_USD=
# Concurrent operations, 1 to 4, and how long a dispatch may wait for a slot in seconds, at most 2;
# empty for the defaults of 4 and 2.
AI_SERVICE_MAX_OPERATIONS=
AI_SERVICE_ADMISSION_WAIT_S=
# How long a shutdown waits for running operations before it interrupts them, in seconds, at most
# 65; empty for the default of 25. Uvicorn allows the grace plus 10 s, so a container's stop grace
# period must be at least that long.
AI_SERVICE_SHUTDOWN_GRACE_S=
# The metadata-only trace export to Langfuse (apps/ai-service/AGENTS.md, Trace export): the
# project's base address (the EU one is https://cloud.langfuse.com) and its public and secret keys.
# All three or none; any one empty turns the export off and never fails an answer. The secret key
# belongs only in the server's production environment file, never in a development checkout; leave
# these empty here. The environment label is lowercase letters, digits, `-` or `_`, at most 40,
# not starting with `langfuse`; empty for `development`.
AI_SERVICE_LANGFUSE_BASE_URL=
AI_SERVICE_LANGFUSE_PUBLIC_KEY=
AI_SERVICE_LANGFUSE_SECRET_KEY=
AI_SERVICE_LANGFUSE_ENVIRONMENT=
# An optional pinned local detector folder for the trace export (absolute path; its detector.json
# pins model, revision, licence, runtime and checksums). Empty: no detector. No detector is accepted
# yet, so any folder is refused at start and the export stays metadata-only. The container stacks
# do not pass it: a detector folder would need a read-only mount.
AI_SERVICE_TRACE_DETECTOR_DIR=

# MCP Admin (apps/mcp-admin/AGENTS.md, "Configuration"). Every setting is required; it listens on
# MCP_ADMIN_PORT. It holds no API key: each caller sends its own as `Authorization: Bearer`.
# Interface it listens on. Keep it on loopback; reach it from elsewhere through an SSH tunnel.
MCP_ADMIN_HOST=127.0.0.1
# Base address of the content API it calls with the caller's key: an http or https address without
# credentials, query or fragment. Worktree setup writes the worktree's own API port here.
MCP_ADMIN_API_URL=http://127.0.0.1:3001
# Comma-separated host names (without port) a request's Host header may name; others get 403.
MCP_ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated host names a request's Origin header may name. Empty: every request that carries
# an Origin (a browser page) is refused; MCP clients send none.
MCP_ADMIN_ALLOWED_ORIGINS=
# Comma-separated addresses of reverse proxies whose X-Forwarded-For is believed. Empty: the client
# address is the connection's.
MCP_ADMIN_TRUSTED_PROXIES=
# Largest accepted request body in bytes. It also bounds an `upload`, whose file travels as base64
# (a third larger): 65536 admits a file of roughly 48 KiB.
MCP_ADMIN_BODY_LIMIT_BYTES=65536
# Longest an MCP request may take in milliseconds, its content API calls included.
MCP_ADMIN_TIMEOUT_MS=15000
# Most MCP requests in progress at once; beyond it a request is refused with 503.
MCP_ADMIN_MAX_CONCURRENT=8
# Rate-limit budgets, `<requests>/<seconds>` in a fixed window: preauth per client address before
# the key is checked, key per verified API key. Keep preauth within API_RATE_LIMIT_PRIVATE: every
# request's key check is a private API request from MCP Admin's own address.
MCP_ADMIN_RATE_LIMIT_PREAUTH=30/60
MCP_ADMIN_RATE_LIMIT_KEY=30/60
# Most callers tracked at once across both budgets; beyond it the oldest window is forgotten.
MCP_ADMIN_RATE_LIMIT_MAX_TRACKED=1000

# The website (apps/web/AGENTS.md, "Configuration"). Every setting is required at runtime; the
# build needs none of them.
# Interface the website listens on (`pnpm --filter @sebela/web dev` and `start`); `pnpm stack:up`
# publishes the website container on WEB_HOST and WEB_PORT.
WEB_HOST=127.0.0.1
# Base address of the API whose public routes the website reads: its origin, or an origin with a
# path prefix in front of `/v1`. Worktree setup writes the worktree's own API port here.
WEB_API_BASE_URL=http://127.0.0.1:3001
# The site's canonical public origin (scheme, host and port only): canonical links, structured data,
# the sitemap, robots.txt and llms.txt name it, whatever host a request used. Worktree setup writes
# the worktree's own website origin here; production sets its public domain.
WEB_SITE_ORIGIN=http://127.0.0.1:3000
# The media folder the website shows and optimises images from: STORAGE_PUBLIC_BASE_URL followed by
# STORAGE_ENVIRONMENT and, in a worktree, STORAGE_WORKTREE (plain folder names, no query). Pages show
# the image files directly below it from the site's own path /media/<file>, which the image
# optimizer reads; never an address a visitor names. Worktree setup writes the worktree's own folder
# here.
WEB_MEDIA_BASE_URL=http://127.0.0.1:3001/v1/media/files/development
# Where the website's server reads those files, when it cannot use the media base itself: the same
# folder at another address, such as the API's internal address inside the Compose network, which
# compose.yaml sets for the website container. Never shown to visitors. Leave empty on the host: the
# server then reads the media base.
WEB_MEDIA_READ_BASE_URL=
# The server-only secret that verifies the API's signed invalidation notifications at
# POST /internal/invalidation: the same value as API_WEB_INVALIDATION_SECRET, at least 32
# characters. Pages render without it; the receiver then answers 500 and the API retries. Never put
# a real secret in this file; worktree setup generates the worktree's own pair.
WEB_INVALIDATION_SECRET=
# The fallback revalidation interval in whole seconds (1 to 86400): how long the website keeps a
# cached API answer before the next request reads it again, independent of invalidation
# notifications. Leave empty for the default of 60.
WEB_CONTENT_REVALIDATE_SECONDS=
# Optional, cookieless page-view analytics with Umami (apps/web/AGENTS.md, "Configuration"). Leave
# both empty for no analytics: the pages then carry nothing of it, as in development, tests and CI.
# Set both or neither. The tracker script's address: https (plain http only while WEB_SITE_ORIGIN is
# plain http), no credentials, query or fragment, such as https://cloud.umami.is/script.js.
WEB_ANALYTICS_SCRIPT_URL=
# The website's identifier on the analytics service, a UUID; public, it appears in every page. The
# production account, its free plan's limits and the production values belong to the server
# preparation (infra/README.md).
WEB_ANALYTICS_WEBSITE_ID=
# Whether search engines may index the site (apps/web/AGENTS.md, "Metadata and indexing"): `on`
# allows it; empty or `off` sends `noindex, nofollow` in every response's X-Robots-Tag header and
# every page's robots meta tag. Leave empty everywhere but the launched production site.
WEB_INDEXING=
# The public Turnstile site key of the chat's bot challenge; it appears in the page. Development uses
# Cloudflare's always-pass test site key `1x00000000000000000000AA`. Empty while the chat is off.
WEB_TURNSTILE_SITE_KEY=
# The chat relay's token, the API's API_CHAT_RELAY_TOKEN (at least 32 characters). Empty while the
# chat is off: the website's chat routes then answer 503 `unavailable` without reaching the API.
WEB_CHAT_RELAY_TOKEN=
# How many proxies in front of the website append the address they saw to X-Forwarded-For (0 to
# 10). The relay names the entry that many places from the right as the visitor's address and never
# forwards X-Forwarded-For itself; entries further left are the visitor's own claims. Empty or 0
# (development: nothing in front): no address is named, and every visitor shares one quota.
WEB_TRUSTED_PROXY_HOPS=

# Uploaded media (apps/api/AGENTS.md, "Configuration"; packages/services/AGENTS.md). Every setting
# is required. `local` keeps the files on disk and the API serves them; selecting a cloud driver
# that is not available or not configured stops the process instead of writing locally.
STORAGE_DRIVER=local
# Folder of the local files, relative to the process's working directory (apps/api): the
# checkout's git-ignored scratch folder `.tmp/`, so development uploads stay disposable. The
# container stack ignores it and keeps its files in the Compose volume `api-media`.
STORAGE_LOCAL_ROOT=../../.tmp/storage
# First folder of every key: development, test or production.
STORAGE_ENVIRONMENT=development
# Folder below the environment that keeps a worktree's files apart; empty in the main checkout.
# Worktree setup writes the worktree's own value, and its API port in STORAGE_PUBLIC_BASE_URL, into
# the worktree's generated .env.local.
STORAGE_WORKTREE=
# The address files are served from; public media addresses are computed from it, so changing it
# needs no migration. Locally, the API's own file route.
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:3001/v1/media/files
# Only for STORAGE_DRIVER=bunny-s3 (docs/architecture.md, "Bunny Storage"): the zone's S3 endpoint
# (a bare https origin), its region code, the zone name and the zone password. Use the development
# zone's values in a development checkout, never production's. STORAGE_PUBLIC_BASE_URL is then the
# https address of the zone's CDN pull zone, and STORAGE_WORKTREE is required in development.
STORAGE_BUNNY_ENDPOINT=
STORAGE_BUNNY_REGION=
STORAGE_BUNNY_ZONE=
STORAGE_BUNNY_PASSWORD=
# Largest accepted file in bytes (10 MiB), and largest accepted image width and height in pixels.
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_IMAGE_DIMENSION=8000

# Private storage for the originals of supplemental knowledge documents (apps/api/AGENTS.md,
# "Configuration"; packages/services/AGENTS.md). Read only by the `knowledge` document commands;
# its files never get an address and are never served. The driver is always explicit: `local` or
# `bunny-s3`; an invalid or incomplete selection stops the command instead of writing elsewhere.
# Keys use the STORAGE_ENVIRONMENT and STORAGE_WORKTREE folders of the media above.
PRIVATE_STORAGE_DRIVER=local
# Folder of the local private files, relative to the process's working directory (apps/api): a
# git-ignored folder of the checkout's `.tmp/`, never the media folder or one inside or around it.
PRIVATE_STORAGE_LOCAL_ROOT=../../.tmp/private-storage
# Only for PRIVATE_STORAGE_DRIVER=bunny-s3: a separate private zone with its own password and no CDN
# pull zone, never the media zone. Its S3 endpoint (a bare https origin), region code, zone name and
# zone password; use a development zone's values in a development checkout, never production's.
PRIVATE_STORAGE_BUNNY_ENDPOINT=
PRIVATE_STORAGE_BUNNY_REGION=
PRIVATE_STORAGE_BUNNY_ZONE=
PRIVATE_STORAGE_BUNNY_PASSWORD=

# Retrieval over the indexed knowledge (docs/architecture.md, "Knowledge and retrieval";
# packages/memory/AGENTS.md). All empty: retrieval is off and search answers 503. With these
# values set (every one is then required) retrieval is on, but search still answers 503 until the
# embedding provider's key, VOYAGE_API_KEY, is present; it is a secret (.env.secrets.example) and
# never goes in this file. The model, its price in USD per million tokens (Voyage's
# published price) and the most texts per provider call (Voyage accepts up to 1000).
RETRIEVAL_EMBEDDING_MODEL=voyage-4
RETRIEVAL_EMBEDDING_PRICE_PER_MILLION_TOKENS_USD=0.06
RETRIEVAL_EMBEDDING_BATCH_SIZE=128
# The cross-encoder reranker that scores the candidate pool and its price in USD per million tokens
# (Voyage's published price); it uses the same key.
RETRIEVAL_RERANK_MODEL=rerank-3
RETRIEVAL_RERANK_PRICE_PER_MILLION_TOKENS_USD=0.05
# Longest wait for one provider call in milliseconds; a timeout is a typed 503.
RETRIEVAL_PROVIDER_TIMEOUT_MS=10000
# Retries of a rate-limited (429) provider call and the longest wait before one, in milliseconds:
# the provider's Retry-After when it sends one (a longer one gives up at once), otherwise an
# exponential backoff from 1 s capped at the wait. Kept short so a search answers promptly; the
# retrieval evals run with patient values of their own.
RETRIEVAL_PROVIDER_RETRIES=2
RETRIEVAL_PROVIDER_MAX_RETRY_WAIT_MS=2000
# Estimated embedding and reranking spend per calendar month (UTC) in USD; at the ceiling indexing and search stop
# with a typed 503 instead of spending more.
RETRIEVAL_MONTHLY_CEILING_USD=1
# Candidates the reranker scores per query (the vector and full-text candidates fused by reciprocal
# rank), the most passages returned and the reranker score a passage needs to count as evidence.
# Tuned by the evals in packages/memory/evals.
RETRIEVAL_CANDIDATE_POOL=30
RETRIEVAL_FINAL_PASSAGES=5
RETRIEVAL_RELEVANCE_FLOOR=0.38
# For paid eval runs only: an absolute file that keeps query embeddings by model, version and text
# and reuses them, so a repeated question is not embedded again. The retrieval evals set their own
# file below `.tmp/`; leave empty everywhere else.
RETRIEVAL_QUERY_CACHE_FILE=
# For eval runs only: the ranking search uses, `reranked` (the deployed one, also when empty) or one
# of the evals' baselines, never deployed: `hybrid` (the fused pool without the reranker), `vector`
# (cosine similarity only) or `fulltext` (text search only). The retrieval evals set it from
# their `--variant` option; leave empty everywhere else.
RETRIEVAL_EVAL_VARIANT=

# The shared Postgres of compose.yaml: one container for the main checkout and every worktree.
# Compose reads these from the process environment or from `.env` next to compose.yaml.
# Address and host port the container is published on, and that code connects to. The same for
# every worktree; only the database differs.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
# Superuser of the local development cluster. The password is a placeholder: set your own in `.env`
# before the first start. User and password take effect when the volume is first initialised.
POSTGRES_USER=sebela
POSTGRES_PASSWORD=replace-with-a-local-password
# Database created when the volume is first initialised: the main checkout's database. The
# worktree script connects to it to create and drop the worktree databases.
POSTGRES_DB=sebela

# The database this checkout's code uses. The main checkout uses POSTGRES_DB; the worktree script
# creates a database for each worktree (`wt_<branch>_<hash>`) and writes its name here.
DATABASE_NAME=sebela
# The role this checkout's code connects as, and its password. No script creates a role for the
# main checkout: it connects as POSTGRES_USER with POSTGRES_PASSWORD, set as its own in
# `.env`. The worktree script creates a role for each worktree, named like its database, that owns
# its database and may create temporary ones, and writes its name and a random password here. The
# superuser password above never reaches a worktree.
DATABASE_USER=sebela
DATABASE_PASSWORD=replace-with-a-local-password
