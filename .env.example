# Example development configuration. Placeholders and documented example values only: never put
# credentials or real data here. Code reads these settings from the environment and does not carry
# its own copies (docs/repository-structure.md, "Ports and worktree isolation").
#
# Installation (`pnpm install --frozen-lockfile`) needs no settings. The main checkout uses these
# values; copy this file to `.env` there (Compose reads it) and choose your own password. Each
# worktree gets its own `.env.local`, generated by `node harness/worktree.mjs create`, with
# its slot, its shifted ports, its database and its database role's credentials.
#
# Two example files: this one holds the settings — ports, addresses, limits and the local
# passwords of the development database — which agents may read and, in their worktree's
# `.env.local`, change. `.env.secrets.example` holds the owner's keys for paid outside services,
# which agents never see: they live only in the main checkout's `.env.secrets` and reach only the
# command that needs them (docs/permissions.md, "Environment files").

# Worktree slot: 0 is the main checkout, worktrees take 1 to 9.
WORKTREE_SLOT=0

# Ports of the main checkout (slot 0). A worktree with slot N uses each of them + N x 10.
# The worktree script reads them from the process environment first, then from this file.
WEB_PORT=3000
API_PORT=3001
MCP_ADMIN_PORT=3002
LLM_AGENT_PORT=3003

# The API process (apps/api/AGENTS.md, "Configuration"). Every setting is required.
# Interface the API listens on. The container stack (`pnpm stack:up`) publishes the API on this
# address of the host and listens on every interface inside its container.
API_HOST=127.0.0.1
# Largest accepted request body in bytes, enforced while the body is received. 192 KiB leaves room
# for the longest case study (50,000 characters) written in three-byte UTF-8 characters.
API_BODY_LIMIT_BYTES=196608
# Comma-separated addresses of reverse proxies whose X-Forwarded-For is believed. Empty: the client
# address is the connection's and forwarded headers are ignored.
API_TRUSTED_PROXIES=
# Rate-limit budgets, `<requests>/<seconds>` per caller in a fixed window. Health checks have their
# own budget; public covers public reads, the OpenAPI document, the reference and unknown routes;
# private counts every private request per client before its key is verified; key counts the
# requests of each verified API key.
API_RATE_LIMIT_HEALTH=120/60
API_RATE_LIMIT_PUBLIC=300/60
API_RATE_LIMIT_PRIVATE=60/60
API_RATE_LIMIT_KEY=120/60
# Most callers tracked at once across all budgets; beyond it the oldest window is forgotten.
API_RATE_LIMIT_MAX_TRACKED=10000
# Uploads count against their own per-client budget instead of the private one; keep it stricter.
API_RATE_LIMIT_UPLOAD=10/60
# Signed website invalidation after committed content writes (apps/api/AGENTS.md, "Website
# invalidation"): the website's receiver, an http or https address without credentials, query or
# fragment, and the server-only signing secret of at least 32 characters, shared with the website
# only. Both empty: no notifications are sent. Never put a real secret in this file.
API_WEB_INVALIDATION_URL=
API_WEB_INVALIDATION_SECRET=

# MCP Admin (apps/mcp-admin/AGENTS.md, "Configuration"). Every setting is required; it listens on
# MCP_ADMIN_PORT. It holds no API key: each caller sends its own as `Authorization: Bearer`.
# Interface it listens on. Keep it on loopback; reach it from elsewhere through an SSH tunnel.
MCP_ADMIN_HOST=127.0.0.1
# Base address of the content API it calls with the caller's key: an http or https address without
# credentials, query or fragment. Worktree setup writes the worktree's own API port here.
MCP_ADMIN_API_URL=http://127.0.0.1:3001
# Comma-separated host names (without port) a request's Host header may name; others get 403.
MCP_ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated host names a request's Origin header may name. Empty: every request that carries
# an Origin (a browser page) is refused; MCP clients send none.
MCP_ADMIN_ALLOWED_ORIGINS=
# Comma-separated addresses of reverse proxies whose X-Forwarded-For is believed. Empty: the client
# address is the connection's.
MCP_ADMIN_TRUSTED_PROXIES=
# Largest accepted request body in bytes.
MCP_ADMIN_BODY_LIMIT_BYTES=65536
# Longest an MCP request may take in milliseconds, its content API calls included.
MCP_ADMIN_TIMEOUT_MS=15000
# Most MCP requests in progress at once; beyond it a request is refused with 503.
MCP_ADMIN_MAX_CONCURRENT=8
# Rate-limit budgets, `<requests>/<seconds>` in a fixed window: preauth per client address before
# the key is checked, key per verified API key. Keep preauth within API_RATE_LIMIT_PRIVATE: every
# request's key check is a private API request from MCP Admin's own address.
MCP_ADMIN_RATE_LIMIT_PREAUTH=30/60
MCP_ADMIN_RATE_LIMIT_KEY=30/60
# Most callers tracked at once across both budgets; beyond it the oldest window is forgotten.
MCP_ADMIN_RATE_LIMIT_MAX_TRACKED=1000

# The website (apps/web/AGENTS.md, "Configuration"). Every setting is required at runtime; the
# build needs none of them.
# Interface the website listens on (`pnpm --filter @sebela/web dev` and `start`); `pnpm stack:up`
# publishes the website container on WEB_HOST and WEB_PORT.
WEB_HOST=127.0.0.1
# Base address of the API whose public routes the website reads: its origin, or an origin with a
# path prefix in front of `/v1`. Worktree setup writes the worktree's own API port here.
WEB_API_BASE_URL=http://127.0.0.1:3001
# The site's canonical public origin (scheme, host and port only): canonical links, structured data,
# the sitemap, robots.txt and llms.txt name it, whatever host a request used. Worktree setup writes
# the worktree's own website origin here; production sets its public domain.
WEB_SITE_ORIGIN=http://127.0.0.1:3000
# The media folder the website shows and optimises images from: STORAGE_PUBLIC_BASE_URL followed by
# STORAGE_ENVIRONMENT and, in a worktree, STORAGE_WORKTREE (plain folder names, no query). Pages show
# the image files directly below it from the site's own path /media/<file>, which the image
# optimizer reads; never an address a visitor names. Worktree setup writes the worktree's own folder
# here.
WEB_MEDIA_BASE_URL=http://127.0.0.1:3001/v1/media/files/development
# Where the website's server reads those files, when it cannot use the media base itself: the same
# folder at another address, such as the API's internal address inside the Compose network, which
# compose.yaml sets for the website container. Never shown to visitors. Leave empty on the host: the
# server then reads the media base.
WEB_MEDIA_READ_BASE_URL=
# The server-only secret that verifies the API's signed invalidation notifications at
# POST /internal/invalidation: the same value as API_WEB_INVALIDATION_SECRET, at least 32
# characters. Pages render without it; the receiver then answers 500 and the API retries. Never put
# a real secret in this file; worktree setup generates the worktree's own pair.
WEB_INVALIDATION_SECRET=
# The fallback revalidation interval in whole seconds (1 to 86400): how long the website keeps a
# cached API answer before the next request reads it again, independent of invalidation
# notifications. Leave empty for the default of 60.
WEB_CONTENT_REVALIDATE_SECONDS=
# Optional, cookieless page-view analytics with Umami (apps/web/AGENTS.md, "Configuration"). Leave
# both empty for no analytics: the pages then carry nothing of it, as in development, tests and CI.
# Set both or neither. The tracker script's address: https (plain http only while WEB_SITE_ORIGIN is
# plain http), no credentials, query or fragment, such as https://cloud.umami.is/script.js.
WEB_ANALYTICS_SCRIPT_URL=
# The website's identifier on the analytics service, a UUID; public, it appears in every page. The
# production account, its free plan's limits and the deployment's values are set up in phase 8.
WEB_ANALYTICS_WEBSITE_ID=

# Uploaded media (apps/api/AGENTS.md, "Configuration"; packages/services/AGENTS.md). Every setting
# is required. `local` keeps the files on disk and the API serves them; selecting a cloud driver
# that is not available or not configured stops the process instead of writing locally.
STORAGE_DRIVER=local
# Folder of the local files, relative to the process's working directory (apps/api): the
# checkout's git-ignored scratch folder `.tmp/`, so development uploads stay disposable. The
# container stack ignores it and keeps its files in the Compose volume `api-media`.
STORAGE_LOCAL_ROOT=../../.tmp/storage
# First folder of every key: development, test or production.
STORAGE_ENVIRONMENT=development
# Folder below the environment that keeps a worktree's files apart; empty in the main checkout.
# Worktree setup writes the worktree's own value, and its API port in STORAGE_PUBLIC_BASE_URL, into
# the worktree's generated .env.local.
STORAGE_WORKTREE=
# The address files are served from; public media addresses are computed from it, so changing it
# needs no migration. Locally, the API's own file route.
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:3001/v1/media/files
# Only for STORAGE_DRIVER=bunny-s3 (docs/architecture.md, "Bunny Storage"): the zone's S3 endpoint
# (a bare https origin), its region code, the zone name and the zone password. Use the development
# zone's values in a development checkout, never production's. STORAGE_PUBLIC_BASE_URL is then the
# https address of the zone's CDN pull zone, and STORAGE_WORKTREE is required in development.
STORAGE_BUNNY_ENDPOINT=
STORAGE_BUNNY_REGION=
STORAGE_BUNNY_ZONE=
STORAGE_BUNNY_PASSWORD=
# Largest accepted file in bytes (10 MiB), and largest accepted image width and height in pixels.
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_IMAGE_DIMENSION=8000

# The shared Postgres of compose.yaml: one container for the main checkout and every worktree.
# Compose reads these from the process environment or from `.env` next to compose.yaml.
# Address and host port the container is published on, and that code connects to. The same for
# every worktree; only the database differs.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
# Superuser of the local development cluster. The password is a placeholder: set your own in `.env`
# before the first start. User and password take effect when the volume is first initialised.
POSTGRES_USER=sebela
POSTGRES_PASSWORD=replace-with-a-local-password
# Database created when the volume is first initialised: the main checkout's database. The
# worktree script connects to it to create and drop the worktree databases.
POSTGRES_DB=sebela

# The database this checkout's code uses. The main checkout uses POSTGRES_DB; the worktree script
# creates a database for each worktree (`wt_<branch>_<hash>`) and writes its name here.
DATABASE_NAME=sebela
# The role this checkout's code connects as, and its password. No script creates a role for the
# main checkout: it connects as POSTGRES_USER with POSTGRES_PASSWORD, set as its own in
# `.env`. The worktree script creates a role for each worktree, named like its database, that owns
# its database and may create temporary ones, and writes its name and a random password here. The
# superuser password above never reaches a worktree.
DATABASE_USER=sebela
DATABASE_PASSWORD=replace-with-a-local-password
