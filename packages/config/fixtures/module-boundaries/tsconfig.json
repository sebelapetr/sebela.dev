{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "paths": {
      "@sebela/services": ["./packages/services/src/index.ts"],
      "@sebela/db": ["./packages/db/src/index.ts"],
      "~services/*": ["./packages/services/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts"]
}
