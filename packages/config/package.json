{
  "name": "@sebela/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint, TypeScript and Prettier configuration for the sebela.dev workspace.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./eslint": "./eslint.js",
    "./prettier": "./prettier.js",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./vitest": {
      "types": "./vitest.d.ts",
      "default": "./vitest.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"*.test.js\"",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": ">=6.0.0 <6.1.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
