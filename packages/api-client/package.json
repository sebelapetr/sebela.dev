{
  "name": "@sebela/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "The typed HTTP client of the API, generated from its OpenAPI document.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "generate": "openapi-typescript src/generated/openapi.json --output src/generated/schema.ts --default-non-nullable false",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@sebela/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
